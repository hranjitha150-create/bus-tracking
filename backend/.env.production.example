# Template only: set real values privately; do not overwrite an existing .env.
DJANGO_SETTINGS_MODULE=config.production
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-generated-unique-secret-at-least-50-characters
DJANGO_ALLOWED_HOSTS=transport.your-college.example
DATABASE_URL=postgresql://college_runtime:URL_ENCODED_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
# Only behind a proxy that strips and replaces forwarded headers:
DJANGO_TRUST_PROXY_HTTPS=False
# Enable only after verifying ownership/HTTPS on all relevant subdomains:
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False
ENABLE_ROUTE_REPLAY=False
STUDENT_POLL_INTERVAL_SECONDS=10
ADMIN_POLL_INTERVAL_SECONDS=10
LOCATION_HISTORY_ENABLED=True
LOCATION_HISTORY_MIN_INTERVAL_SECONDS=10
LOCATION_HISTORY_RETENTION_DAYS=30
