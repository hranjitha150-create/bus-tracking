DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Copy the session pooler URI from Supabase Connect (port 5432); URL-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
STUDENT_POLL_INTERVAL_SECONDS=10
# Phase 5 GPS/ETA defaults (metres, seconds, km/h as named).
ADMIN_POLL_INTERVAL_SECONDS=10
GPS_MAX_ACCURACY_METERS=100
GPS_MAX_SPEED_MPS=45
GPS_JUMP_ALLOWANCE_METERS=50
ROUTE_CORRIDOR_METERS=50
ROUTE_STOP_SNAP_METERS=150
STOP_PASSED_METERS=25
ETA_FALLBACK_SPEED_KMH=20
ETA_STATIONARY_SECONDS=30
ETA_STOP_DWELL_SECONDS=15
LOCATION_HISTORY_ENABLED=True
LOCATION_HISTORY_MIN_INTERVAL_SECONDS=0
LOCATION_HISTORY_RETENTION_DAYS=30
ENABLE_ROUTE_REPLAY=False
OSRM_BASE_URL=https://router.project-osrm.org
