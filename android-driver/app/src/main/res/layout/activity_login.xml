<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_vertical">
    <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/ic_bus" android:contentDescription="@string/text_campus_transit"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/text_campus_transit_driver" android:textColor="@color/teal" android:textSize="11sp" android:letterSpacing="0.12" android:layout_marginTop="18dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/text_your_route_nyour_college" android:textSize="36sp" android:textColor="@color/ink" android:fontFamily="sans-serif-medium" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/text_sign_in_with_the_driver_account_provided_by_your_college" android:textSize="15sp" android:textColor="@color/muted" android:layout_marginTop="12dp" android:layout_marginBottom="28dp"/>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/emailLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/text_college_email" app:boxBackgroundMode="outline">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:singleLine="true"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/passwordLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/text_password" android:layout_marginTop="14dp" app:boxBackgroundMode="outline" app:endIconMode="password_toggle">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/password" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false" android:singleLine="true"/>
    </com.google.android.material.textfield.TextInputLayout>
    <TextView android:id="@+id/loginStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/danger" android:accessibilityLiveRegion="polite" android:layout_marginTop="16dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/login" android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/text_sign_in" android:layout_marginTop="12dp"/>
    <ProgressBar android:id="@+id/loginProgress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" android:layout_marginTop="12dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/text_location_is_shared_only_after_you_start_or_resume_a_verified_acti" android:textSize="12sp" android:textColor="@color/muted" android:layout_marginTop="28dp" android:lineSpacingExtra="4dp"/>
</LinearLayout></ScrollView>
